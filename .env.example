# Moonlight Chinese Shop Configuration

# Telegram Bot Token from @BotFather
BOT_TOKEN=9277851759:AAHjlbBoYpim8N5Xg-GCVodWaYU8Kxhq1VA

# One polling process per token. Set false for local API/Mini App previews.
BOT_POLLING_ENABLED=true

# Owner setup code: secret token for the one-time claim link:
# https://t.me/<bot>?start=claim_<OWNER_SETUP_CODE>
OWNER_SETUP_CODE=moonlight_owner_secret_998877_setup

# URL where the Mini App is served (HTTPS required for Telegram WebApp)
WEBAPP_URL=http://localhost:8001

# SQLite (default) or PostgreSQL (e.g. postgresql+asyncpg://user:pass@host/db)
DATABASE_URL=sqlite+aiosqlite:///./moonlight_shop.db

# Optional developer admin ID for testing during development
DEV_ADMIN_ID=
# Local browser preview only (fake owner login). Keep false in production!
DEV_BROWSER_MODE=false

# Server host & port
HOST=0.0.0.0
PORT=8001
MEDIA_CACHE_DIR=./media_cache
