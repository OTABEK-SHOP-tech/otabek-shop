# BEK STYLE bot sozlamalari. Nusxa oling: .env.example -> .env va to'ldiring.

# @BotFather bergan YANGI bot tokeni (Sakura botining tokeni EMAS!)
BOT_TOKEN=

# Do'kon egasi uchun maxfiy kod (kamida 16 belgi). Yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Egasi bir marta shu havolani ochadi: https://t.me/<BOT_USERNAME>?start=claim_<KOD>
OWNER_SETUP_CODE=

# Baza va fayllar papkasi (odatda o'zgartirish shart emas)
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/bek_style.db
